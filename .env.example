# ═══════════════════════════════════════════════════════════════
# StylistAI V2 — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════

# ─── Server Core (Workstream A) ───────────────────────────────
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ─── Authentication & Security (Workstream A) ─────────────────
JWT_SECRET=super-secure-jwt-secret-min-32-chars-long-change-in-prod
JWT_EXPIRES_IN=7d

# ─── Database: PostgreSQL / Supabase (Workstream A) ───────────
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (public read if RLS enabled)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Secret key — SERVER SIDE ONLY, never expose to client
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
# Optional direct Postgres URI for connection pooling / migrations
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# ─── AI Engine: Groq LPU (Primary) ─────────────────────────────
GROQ_API_KEY=gsk_your_primary_groq_api_key_here
# Optional fallback key if primary hits 429 rate limits or quota
GROQ_API_KEY_FALLBACK=gsk_your_backup_groq_api_key_here
# Or optional comma-separated list of keys: key1,key2,key3
# GROQ_API_KEYS=gsk_key1,gsk_key2

# ─── AI Engine: Google Gemini (Automatic Failover) ─────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
# Optional secondary Gemini backup key
# GEMINI_API_KEY_FALLBACK=AIzaSy_your_backup_gemini_key_here

# ─── Google Calendar Integration (Workstream A / Shared) ──────
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v2/calendar/oauth/callback
GOOGLE_CALENDAR_ID=primary

# ─── Business Localization Defaults ───────────────────────────
DEFAULT_TIMEZONE=America/New_York
DEFAULT_BUSINESS_OPEN=09:00
DEFAULT_BUSINESS_CLOSE=19:00

# ─── Client / Frontend (Workstream B) ─────────────────────────
VITE_API_BASE_URL=http://localhost:3001/api/v2
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxx
